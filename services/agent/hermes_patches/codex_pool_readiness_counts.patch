+    def readiness_counts(self) -> Dict[str, int]:
+        """Return non-secret pool size/selectability counts for host health.
+
+        This deliberately exposes neither credential ids nor labels. Running
+        under the pool lock reuses the exact selector Hermes uses for a model
+        call, so a host can require redundant profiles without guessing from
+        persisted status strings or token metadata.
+        """
+        with self._lock:
+            available, _pending = self._available_entries()
+            return {
+                "profile_count": len(self._entries),
+                "selectable_count": len(available),
+            }
