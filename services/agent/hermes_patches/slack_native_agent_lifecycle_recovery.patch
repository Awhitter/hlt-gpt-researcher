+        control = None
+        if run_generation is not None:
+            control = controls.get((session_key, int(run_generation)))
+        else:
+            matches = [
+                item
+                for (key, _generation), item in controls.items()
+                if key == session_key and not item["worker_done"].is_set()
+            ]
+            if len(matches) == 1:
+                control = matches[0]
