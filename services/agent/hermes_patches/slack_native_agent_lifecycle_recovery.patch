+                return ("external_send", "HTTP request with outbound data")
+
+        if name.startswith((
+            "boto3.client.",
+            "boto3.resource.",
+            "google.cloud.",
+        )):
+            if method.startswith(("delete", "remove", "terminate")):
+                return ("delete", f"cloud deletion via {method}")
+            if method not in {
+                "client", "resource", "session", "get", "head", "list",
+                "describe", "download_file", "get_paginator", "get_waiter",
+            }:
+                return ("unknown_effect", f"unclassified cloud action via {name}")
+
+        if name.startswith((
+            "boto3.", "google.cloud.", "kubernetes.", "paramiko.", "slack_sdk.",
+            "agentmail.", "smtplib.", "ftplib.", "socket.",
+        )) and method not in {
+            "client", "resource", "session", "get", "head", "list", "read",
+            "search", "status", "describe", "download", "download_file",
+        }:
+            return ("unknown_effect", f"unclassified provider action via {name}")
+
+    return None
