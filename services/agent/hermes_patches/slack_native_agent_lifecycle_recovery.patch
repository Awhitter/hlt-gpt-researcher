+        worker_release = threading.Event()
+        worker_done = threading.Event()
+        interrupt_requested = threading.Event()
+
+        def blocking_worker():
+            worker_started.set()
+            try:
+                worker_release.wait(timeout=2)
+            finally:
+                worker_done.set()
+
+        loop = asyncio.get_running_loop()
+        worker_future = loop.run_in_executor(None, blocking_worker)
+        await asyncio.to_thread(worker_started.wait, 1)
+        outer_task = asyncio.create_task(asyncio.sleep(10))
+        adapter._session_tasks[META["gateway_session_key"]] = outer_task
+        runner._hlt_managed_turn_controls = {
