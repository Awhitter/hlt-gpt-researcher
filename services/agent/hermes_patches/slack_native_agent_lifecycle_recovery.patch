+        assert key not in adapter._stopping_streams
+        assert key not in adapter._finalized_streams
+        runner._interrupt_and_clear_session.assert_not_awaited()
+
+        worker_release.set()
+        await asyncio.wait_for(worker_future, timeout=1)
+        await asyncio.wait_for(stop_task, timeout=1)
+
+        assert outer_task.cancelled()
+        runner._interrupt_and_clear_session.assert_awaited_once()
