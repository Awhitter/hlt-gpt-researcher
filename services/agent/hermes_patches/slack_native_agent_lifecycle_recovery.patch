+            "set_permissions", "share",
+        }:
+            return ("access_grant", f"access change via {method}")
+        if method in {
+            "create_api_key", "delete_api_key", "revoke", "revoke_key",
+            "rotate", "rotate_key", "set_password",
+        }:
+            return ("credential_change", f"credential change via {method}")
+
+        if method in {"execute", "executemany", "executescript"} and node.args:
+            try:
+                statement = ast.literal_eval(node.args[0])
+            except (ValueError, TypeError, SyntaxError):
+                return ("unknown_effect", "dynamic database statement")
+            if not isinstance(statement, str) or not read_sql.match(statement):
+                return (
+                    "protected_production_change",
+                    "database mutation from execute_code",
+                )
+
+        if method in {"request", "urlopen"}:
