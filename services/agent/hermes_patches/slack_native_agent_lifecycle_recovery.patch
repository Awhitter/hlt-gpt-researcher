+def _managed_execute_code_effect(code: str) -> tuple[str, str] | None:
+    """Return the outward/risky effect in a managed execute_code script.
+
+    HLT's effect contract keeps local reasoning, reads, transformations,
+    drafts, and reversible file staging autonomous. ``execute_code`` remains
+    a real escape hatch, though: subprocesses, HTTP writes, cloud mutations,
+    deletion, spend, credential/access changes, and production changes must
+    still reach the same human gate as their first-class tool equivalents.
+    Unknown dynamic execution is fail-closed.
+    """
+    try:
+        tree = ast.parse(code)
+    except (SyntaxError, ValueError, TypeError):
+        return ("unknown_effect", "execute_code effect could not be classified")
+
+    aliases: dict[str, str] = {}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for item in node.names:
+                aliases[item.asname or item.name.split(".")[0]] = item.name
+        elif isinstance(node, ast.ImportFrom) and node.module:
+            for item in node.names:
+                aliases[item.asname or item.name] = f"{node.module}.{item.name}"
+
+    object_origins: dict[str, str] = {}
+
+    def call_name(func: ast.AST) -> str:
+        if isinstance(func, ast.Name):
+            return object_origins.get(
+                func.id,
+                aliases.get(func.id, func.id),
+            ).lower()
+        if isinstance(func, ast.Attribute):
+            base = call_name(func.value)
+            return f"{base}.{func.attr}".strip(".").lower()
+        if isinstance(func, ast.Call):
+            called = call_name(func.func)
+            if called in {"__import__", "builtins.__import__"} and func.args:
+                try:
+                    module = ast.literal_eval(func.args[0])
