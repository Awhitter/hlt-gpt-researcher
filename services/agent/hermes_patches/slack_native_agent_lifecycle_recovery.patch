+    def _register_managed_turn_control(
+        self,
+        session_key: str,
+        run_generation: Optional[int],
+    ) -> Optional[Dict[str, Any]]:
+        """Register the executor identity before any admitted-turn await."""
+        if (
+            not session_key
+            or run_generation is None
+            or os.getenv("HLT_MANAGED_MODEL_ROUTE", "").strip().lower()
+            not in {"1", "true", "yes", "on"}
+        ):
+            return None
+        controls = self._managed_turn_controls()
+        key = (session_key, int(run_generation))
+        existing = controls.get(key)
+        if existing is not None:
+            return existing
+        control = {
+            "agent_holder": [None],
+            "worker_done": threading.Event(),
+            "executor_task": None,
+            "stream_task": None,
+            "stop_requested": False,
+            "stream_consumer": None,
+            "created_at": time.monotonic(),
+        }
+        controls[key] = control
+        if len(controls) > 256:
+            for control_key, candidate in list(controls.items()):
+                if candidate["worker_done"].is_set():
+                    controls.pop(control_key, None)
+                if len(controls) <= 128:
+                    break
+        return control
