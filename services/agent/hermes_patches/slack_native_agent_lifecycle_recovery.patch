+        if method in {
+            "publish", "create_issue", "create_release", "release", "comment",
+            "create_comment", "submit_review",
+        }:
+            return ("external_publish", f"external publish via {method}")
+        if method in {
+            "deploy", "promote", "push", "promote_to_production",
+        }:
+            return (
