+        """Return the managed K2 pack marker currently installed for this agent.
+
+        HLT's host can replace its reviewed outage SOUL with the canonical
+        Katailyst2 runtime pack while this gateway remains online. Gateway
+        sessions intentionally cache their assembled system prompt, so the
+        marker is the small, versioned epoch that makes that hot promotion
+        visible on the next turn without discarding conversation history.
+        """
+        try:
+            from pathlib import Path
+
+            from agent.system_prompt import _agent_home
+
+            home = _agent_home(agent)
+            if home is None:
+                return ""
+            source_prefix = "<!-- source: katailyst2 agents.runtime_pack "
+            for line in (Path(home) / "SOUL.md").read_text(
+                encoding="utf-8", errors="replace"
+            ).splitlines():
+                marker = line.strip()
+                if marker.startswith(source_prefix) and marker.endswith("-->"):
+                    return marker
+        except Exception:
+            # Runtime identity checks are advisory cache invalidation. A read
+            # failure must not turn into a rebuild loop on every message.
+            pass
+        return ""
