     return _resolve_turn_limit(os.getenv("HERMES_MAX_ITERATIONS"))
 
 
+def _current_max_iterations_for_platform(config: Any, platform_key: str) -> int:
+    """Apply an optional per-platform cap without widening the global budget.
+
+    ``agent.max_turns`` remains the authoritative ceiling for every surface.
+    Managed messaging profiles may additionally set
+    ``agent.platform_max_turns.<platform>`` when an interactive channel needs a
+    faster fail-safe than long-running API or local work. Invalid values are
+    ignored rather than taking the gateway down.
+    """
+    global_limit = _current_max_iterations()
+    if not isinstance(config, dict):
+        return global_limit
+    agent_config = config.get("agent")
+    if not isinstance(agent_config, dict):
+        return global_limit
+    platform_limits = agent_config.get("platform_max_turns")
+    if not isinstance(platform_limits, dict):
+        return global_limit
+    raw_limit = platform_limits.get(str(platform_key or "").strip().lower())
+    if raw_limit is None or isinstance(raw_limit, bool):
+        return global_limit
+    try:
+        platform_limit = int(raw_limit)
+    except (TypeError, ValueError):
+        return global_limit
+    if platform_limit < 1:
+        return global_limit
+    return min(global_limit, platform_limit)
+
