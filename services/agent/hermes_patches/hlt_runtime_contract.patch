index 00000000..6e693d0e
--- /dev/null
+++ b/gateway/run_managed_slack.py
@@ -0,0 +1,414 @@
+"""Exact-worker controls and one-response lifecycle for managed Slack turns."""
+from __future__ import annotations
+import asyncio
+import logging
+import os
+import threading
+import time
+from typing import Any, Dict, Optional, Tuple
+from gateway.config import Platform
+from gateway.session import SessionSource
+logger = logging.getLogger("gateway.run")
+
+def _managed_model_route_enabled() -> bool:
+    return os.getenv("HLT_MANAGED_MODEL_ROUTE", "").strip().lower() in {
+        "1",
+        "true",
+        "yes",
+        "on",
+    }
+
+
+def _managed_slack_status_progress_message(
+    event_type: str,
+    message: str,
+) -> Optional[str]:
+    """Translate internal lifecycle signals into optional teammate progress."""
+    text = str(message or "").strip()
+    lowered = text.lower()
+    if not text:
+        return None
+    if "iteration budget exhausted" in lowered:
+        return "I’m wrapping up the strongest answer from the work completed so far."
+    if "primary model restored" in lowered:
+        return "I’m back on the primary model and continuing."
+    if "empty response after tool calls" in lowered:
+        return "I’m using the verified work already completed to finish this answer."
+    if "memory" in lowered or "recall" in lowered:
+        return "I’m checking the relevant conversation context."
+    if "waiting" in lowered and any(
+        token in lowered for token in ("lease", "session", "turn")
+    ):
+        return "I’m waiting for the current thread work to finish, then I’ll continue."
+    # Unknown lifecycle/provider/config diagnostics stay in logs. Authored
+    # progress and recognized human-safe lifecycle states own the Slack stream.
+    return None
+
+
+def _managed_slack_notice_progress_message(message: str) -> Optional[str]:
+    """Translate model-capacity notices without exposing provider internals."""
+    text = str(message or "").strip()
+    lowered = text.lower()
+    if not text:
+        return None
+    if "restored" in lowered:
+        return "Model access is restored, and I’m continuing."
+    if any(token in lowered for token in ("credit", "usage", "capacity")):
+        return "I’m checking model capacity before I continue."
+    return None
+
+
+def _managed_fallback_chain() -> list[dict[str, str]]:
+    """Use the reviewed shared fallback when subscription capacity is unavailable."""
+    return [{"provider": "openrouter", "model": "openai/gpt-6-astra"}]
+
+class GatewayManagedSlackMixin:
+    def _managed_turn_controls(self) -> Dict[Tuple[str, int], Dict[str, Any]]:
+        """Return exact worker controls for HLT-managed Slack turns.
+
+        The adapter's asyncio session task is only a wrapper around the real
+        executor worker. Cancelling that wrapper does not stop a blocking
+        model/tool call, so Slack Stop uses this generation-scoped registry to
+        interrupt and await the real worker before it suppresses output.
+        """
+        controls = self.__dict__.get("_hlt_managed_turn_controls")
+        if controls is None:
+            controls = {}
+            self.__dict__["_hlt_managed_turn_controls"] = controls
+        return controls
+
+
+    def _register_managed_turn_control(
+        self,
+        session_key: str,
+        run_generation: Optional[int],
+    ) -> Optional[Dict[str, Any]]:
+        """Register the executor identity before any admitted-turn await."""
+        if (
+            not session_key
+            or run_generation is None
+            or os.getenv("HLT_MANAGED_MODEL_ROUTE", "").strip().lower()
+            not in {"1", "true", "yes", "on"}
+        ):
+            return None
+        controls = self._managed_turn_controls()
+        key = (session_key, int(run_generation))
+        existing = controls.get(key)
+        if existing is not None:
+            return existing
+        control = {
+            "agent_holder": [None],
+            "worker_done": threading.Event(),
+            "executor_task": None,
+            "stream_task": None,
+            "stop_requested": False,
+            "stream_consumer": None,
+            "created_at": time.monotonic(),
+        }
+        controls[key] = control
+        if len(controls) > 256:
+            for control_key, candidate in list(controls.items()):
+                if candidate["worker_done"].is_set():
+                    controls.pop(control_key, None)
+                if len(controls) <= 128:
+                    break
+        return control
+
+
+    @staticmethod
+    def _publish_managed_slack_stream_progress(
+        consumer: Any,
+        text: str,
+    ) -> bool:
+        """Keep managed Slack lifecycle notices inside the admitted stream."""
+        if not _managed_model_route_enabled() or consumer is None or not text:
+            return False
+        callback = getattr(consumer, "on_commentary", None)
+        if not callable(callback):
+            callback = getattr(consumer, "on_tool_progress", None)
+        if not callable(callback):
+            return False
+        callback(text)
+        return True
+
+
+    def _managed_slack_consumer_for_source(self, source):
+        if source.platform != Platform.SLACK or not _managed_model_route_enabled():
+            return None
+        key = self._session_key_for_source(source)
+        matches = [control.get("stream_consumer") for (session, generation), control in self._managed_turn_controls().items()
+            if session == key and self._is_session_run_current(session, generation)]
+        return matches[0] if len(matches) == 1 else None
+
+    async def _send_slack_lifecycle_notice(
+        self,
+        *,
+        source: SessionSource,
+        consumer: Any,
+        stream_text: str,
+        fallback_text: str,
+        metadata: Optional[Dict[str, Any]] = None,
+    ) -> None:
+        """Update the managed stream, or preserve legacy platform delivery."""
+        if self._publish_managed_slack_stream_progress(consumer, stream_text):
+            return
+        adapter = self._delivery_adapter_for(source)
+        if adapter is not None and source.chat_id:
+            await adapter.send(
+                source.chat_id,
+                fallback_text,
+                metadata=metadata,
+            )
+
+
+    @staticmethod
+    def _should_send_trailing_runtime_footer(
+        source: SessionSource,
+        footer_line: str,
+    ) -> bool:
+        """Never create a provider-detail bubble after a managed Slack stream."""
+        if not footer_line:
+            return False
+        return not (
+            source.platform == Platform.SLACK and _managed_model_route_enabled()
+        )
+
+
+    async def _prime_managed_slack_turn_stream(
+        self,
+        *,
+        source: SessionSource,
+        session_key: str,
+        run_generation: int,
+        event_message_id: Optional[str],
+        control: Optional[Dict[str, Any]],
+    ) -> Any:
+        """Open the one Slack response stream immediately after admission."""
+        if source.platform != Platform.SLACK or control is None:
+            return None
+        existing = control.get("stream_consumer")
+        if existing is not None:
+            return existing
+        try:
+            from gateway.run import _load_gateway_config, _platform_config_key
+            from gateway.config import StreamingConfig
+            from gateway.display_config import resolve_display_setting
+            from gateway.stream_consumer import GatewayStreamConsumer
+
+            user_config = _load_gateway_config()
+            scfg = getattr(getattr(self, "config", None), "streaming", None)
+            if scfg is None:
+                scfg = StreamingConfig()
+            platform_setting = resolve_display_setting(
+                user_config, _platform_config_key(source.platform), "streaming"
+            )
+            enabled = (
+                scfg.enabled and scfg.transport != "off"
+                if platform_setting is None
+                else bool(platform_setting)
+            )
+            if not enabled:
+                return None
+            adapter = self._delivery_adapter_for(source)
+            if adapter is None:
+                return None
+            cfg, pause = self._build_stream_consumer_config(
+                source,
+                scfg,
+                adapter,
+                on_missing_cursor="raise",
+            )
+            metadata = dict(
+                self._thread_metadata_for_source(source, event_message_id) or {}
+            )
+            metadata["gateway_session_key"] = session_key
+            metadata["gateway_run_generation"] = run_generation
+            if source.profile:
+                metadata["gateway_profile"] = source.profile
+            consumer = GatewayStreamConsumer(
+                adapter=adapter,
+                chat_id=source.chat_id,
+                config=cfg,
+                metadata=metadata,
+                on_before_finalize=pause,
+                initial_reply_to_id=event_message_id,
+                run_still_current=lambda: (
+                    self._is_session_run_current(session_key, run_generation)
+                    and not (
+                        control.get("stop_requested")
+                        and control["worker_done"].is_set()
+                    )
+                ),
+            )
+            control["stream_consumer"] = consumer
+            status_task = None
+            if hasattr(adapter, "set_native_agent_session_status"):
+                status_task = asyncio.create_task(
+                    adapter.set_native_agent_session_status(
+                        source.chat_id, "processing", metadata=metadata
+                    )
+                )
+            # Prime before waiting on the status API: the acknowledgement is
+            # the user's immediate feedback and owns the eventual final.
+            await consumer.prime()
+            status_ok = False
+            if status_task is not None:
+                try:
+                    status_ok = await asyncio.wait_for(status_task, timeout=1.5)
+                except Exception:
+                    status_ok = False
+            if not status_ok:
+                await adapter.send_typing(source.chat_id, metadata=metadata)
+            return consumer
+        except Exception:
+            logger.debug(
+                "Could not prime Slack stream immediately after admission",
+                exc_info=True,
+            )
+            return None
+
+
+    async def _finish_managed_slack_admission_failure(
+        self,
+        *,
+        source: SessionSource,
+        session_key: str,
+        run_generation: int,
+        event_message_id: Optional[str],
+        final_text: Optional[str] = None,
+    ) -> bool:
+        """Seal an admitted Slack stream when no normal worker result exists.
+
+        Once ``chat.startStream`` has been attempted, a separate fallback
+        message can duplicate an ambiguously accepted stream. This helper
+        therefore owns the failure exclusively through the existing consumer
+        and tells Base that no ordinary error bubble should be posted.
+        """
+        control = self._managed_turn_controls().get(
+            (session_key, int(run_generation))
+        )
+        consumer = control.get("stream_consumer") if control is not None else None
+        if source.platform != Platform.SLACK or consumer is None:
+            return False
+        final_text = final_text or (
+            "I couldn’t start that run. Your request is preserved in this "
+            "thread—please try again shortly."
+        )
+        stream_task = control.get("stream_task")
+        if stream_task is None:
+            stream_task = asyncio.create_task(consumer.run())
+            control["stream_task"] = stream_task
+        consumer.finish(final_text)
+        try:
+            await asyncio.wait_for(asyncio.shield(stream_task), timeout=5.0)
+        except asyncio.CancelledError:
+            raise
+        except Exception:
+            # The stream start/final ACK may be ambiguous. Never open a second
+            # visible response after that point; leave the same stream identity
+            # available for transport-level recovery.
+            logger.warning(
+                "Managed Slack admission stream finalization was uncertain for %s",
+                session_key,
+                exc_info=True,
+            )
+        try:
+            adapter = self._delivery_adapter_for(source)
+            if adapter is not None and hasattr(
+                adapter, "set_native_agent_session_status"
+            ):
+                await adapter.set_native_agent_session_status(
+                    source.chat_id,
+                    "active",
+                    metadata=self._thread_metadata_for_source(
+                        source, event_message_id
+                    ),
+                )
+        except Exception:
+            logger.debug(
+                "Could not clear failed Slack admission status", exc_info=True
+            )
+        return True
+
+
+    async def _request_and_confirm_managed_turn_stop(
+        self,
+        session_key: str,
+        run_generation: Optional[int],
+        *,
+        reason: str,
+        timeout: float = 5.0,
+    ) -> bool:
+        """Interrupt and await the exact executor worker for one Slack run.
+
+        ``asyncio.Task.cancel()`` cannot cancel code already executing in a
+        thread-pool worker. This method therefore treats the worker's own
+        completion event as the confirmation boundary. No run-generation
+        invalidation or output suppression happens here; the caller performs
+        those state changes only after this returns ``True``.
+        """
+        from gateway.run import request_hard_interrupt
+        controls = self._managed_turn_controls()
+        control = None
+        if run_generation is not None:
+            control = controls.get((session_key, int(run_generation)))
+        else:
+            matches = [
+                item
+                for (key, _generation), item in controls.items()
+                if key == session_key and not item["worker_done"].is_set()
+            ]
+            if len(matches) == 1:
+                control = matches[0]
+        if control is None:
+            # A native stream is registered after this control, so absence is
+            # not evidence that an admitted turn has no worker. Fail closed.
+            return False
+
+        control["stop_requested"] = True
+        worker_done = control["worker_done"]
+        executor_task = control.get("executor_task")
+        if executor_task is None:
+            # The event loop has not dispatched the worker yet. The stop flag
+            # prevents dispatch, and the caller can safely cancel the wrapper.
+            return True
+        if worker_done.is_set():
+            return True
+
+        deadline = time.monotonic() + max(0.0, float(timeout))
+        interrupted_agent = None
+        while True:
+            agent_holder = control.get("agent_holder") or []
+            agent = agent_holder[0] if agent_holder else None
+            if agent is not None and agent is not interrupted_agent:
+                try:
+                    request_hard_interrupt(agent, reason)
+                    interrupted_agent = agent
+                except Exception:
+                    logger.debug(
+                        "Failed to request hard interrupt for managed turn %s/%s",
+                        session_key,
+                        run_generation,
+                        exc_info=True,
+                    )
+            if worker_done.is_set():
+                return True
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                return False
+            await asyncio.sleep(min(0.02, remaining))
+
+
+    def _release_managed_turn_control(
+        self,
+        session_key: str,
+        run_generation: Optional[int],
+    ) -> None:
+        """Forget a completed/prevented worker after Stop commits."""
+        controls = self._managed_turn_controls()
+        if run_generation is not None:
+            controls.pop((session_key, int(run_generation)), None)
+            return
+        matches = [key for key in controls if key[0] == session_key]
+        if len(matches) == 1:
+            controls.pop(matches[0], None)
