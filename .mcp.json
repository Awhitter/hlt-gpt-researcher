{
  "mcpServers": {
    "katailyst2": {
      "type": "http",
      "url": "https://katailyst2.vercel.app/api/mcp",
      "headers": {
        "Authorization": "Bearer ${KATAILYST_MCP_TOKEN}"
      }
    },
    "multimediaMastery": {
      "type": "http",
      "url": "https://mmm2-three.vercel.app/api/media/v1/mcp",
      "headers": {
        "Authorization": "Bearer ${MM_AGENT_TOKEN}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}"
      }
    },
    "gpt-researcher": {
      "type": "http",
      "url": "https://gpt-researcher-mcp-production.up.railway.app/mcp",
      "headers": {
        "Authorization": "Bearer ${GPTR_MCP_TOKEN}"
      }
    }
  }
}
